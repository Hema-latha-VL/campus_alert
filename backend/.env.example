PORT=5000
NODE_ENV=development

# MongoDB Connection String
# See MONGODB_SETUP.md for setup instructions
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/alerthub
# For Local MongoDB: mongodb://localhost:27017/alerthub
MONGODB_URI=mongodb://localhost:27017/alerthub

# JWT Configuration - CHANGE THIS IN PRODUCTION!
JWT_SECRET=CHANGE_ME_DEV_ONLY_your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# CORS - Add your frontend URLs here
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Cookie settings (set to true in production with HTTPS)
COOKIE_SECURE=false

# SMTP Configuration for Email Notifications
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Campus Pulse <your-email@gmail.com>
